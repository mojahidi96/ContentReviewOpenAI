APP_ENV=development
HOST=0.0.0.0
PORT=8000
GOOGLE_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
INTERNAL_SERVICE_TOKEN=replace_with_a_long_random_secret
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/chroma
METADATA_DB_PATH=./data/documents.sqlite3
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=200
MAX_EXTRACTED_CHARS=2000000
MAX_REVIEW_CONTENT_CHARS=100000
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_COUNT=5
SIMILARITY_THRESHOLD=0.25
PROVIDER_TIMEOUT_SECONDS=25
PROVIDER_TOTAL_TIMEOUT_SECONDS=45
PROVIDER_MAX_RETRIES=3
MAX_CONCURRENT_LLM_REQUESTS=4
LOG_LEVEL=INFO
ALLOWED_GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-flash-latest
# Excel file (columns: Deprecated Term, Replacement Term). Default: resources/deprecated_terms.xlsx
# DEPRECATED_TERMS_FILE=resources/deprecated_terms.xlsx
